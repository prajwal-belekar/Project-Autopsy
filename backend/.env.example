# Project Autopsy - Backend Environment Configuration

# Database URL (PostgreSQL for production, SQLite for development)
DATABASE_URL=sqlite:///./project_autopsy.db

# CORS Origins for frontend development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Repository workspace directory (empty for system temp)
REPOSITORY_WORKSPACE=

# Logging level
LOG_LEVEL=INFO

# API prefix
API_PREFIX=/api